generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
  INSTRUCTOR
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PackageType {
  REGULAR
  TRIAL_PREPARATION
  ADDITIONAL_VEHICLE
  DAILY
}

enum VehicleType {
  CAR
  VAN
  MOTORCYCLE
  THREE_WHEELER
}

enum TrainingType {
  REGULAR
  TRIAL_PREPARATION
  DAILY
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  NOT_APPLICABLE
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum VehicleAuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
}

enum PaymentMethod {
  BANK_TRANSFER
  BANK_DEPOSIT
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentReviewDecision {
  APPROVED
  REJECTED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LessonScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum MedicalAppointmentStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum ExamType {
  WRITTEN
  OFFICIAL_DRIVING_TRIAL
  OTHER
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum ExamResult {
  PASS
  FAIL
  PENDING
}

enum AppointmentType {
  MEDICAL
  EXAM
}

model User {
  maintenanceInsurancePolicies     VehicleInsurancePolicy[]
  maintenanceComplianceDecisions   VehicleComplianceDecision[]
  maintenanceEmissionTests         VehicleEmissionTest[]
  maintenanceRevenueLicences       VehicleRevenueLicence[]
  maintenanceServiceRecords        VehicleServiceRecord[]
  maintenanceFaults                VehicleFault[]
  maintenanceRepairEvents          VehicleRepairEvent[]
  maintenanceDocumentsUploaded     VehicleMaintenanceDocument[] @relation("DocumentUploader")
  maintenanceDocumentsDeleted      VehicleMaintenanceDocument[] @relation("DocumentDeleter")
  maintenanceReminderAcks          VehicleMaintenanceReminder[]
  maintenanceReminderSettings      VehicleMaintenanceReminderSetting[]
  maintenanceAuditLogs             VehicleMaintenanceAuditLog[]
  userId                        String                       @id // STU-001, INS-001, ADMIN-001
  email                         String?                      @unique // Required for students and instructors (CHECK in the migration). Admins may have none.
  passwordHash                  String
  role                          UserRole
  status                        AccountStatus                @default(ACTIVE)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  studentProfile                StudentProfile?
  instructorProfile             InstructorProfile?
  sessions                      Session[]
  passwordResetTokens           PasswordResetToken[]
  emailChangeTokens             EmailChangeToken[]
  reviewedPayments              Payment[]                    @relation("PaymentReviewer")
  paymentReviews                PaymentReviewHistory[]       @relation("PaymentReviewUser")
  reviewedRegistrationRequests  RegistrationRequest[]        @relation("RegistrationReviewer")
  appointmentChanges            AppointmentDateHistory[]     @relation("AppointmentChangedBy")
  attendanceMarks               LessonSchedule[]             @relation("AttendanceMarker")
  lessonsCancelled              LessonSchedule[]             @relation("LessonCanceller")
  packagePriceChanges           TrainingPackagePriceChange[] @relation("PackagePriceChanger")
  packageRequirementChanges     TrainingPackageItemChange[]  @relation("PackageRequirementChanger")
  enrollmentRequirementChanges  EnrollmentRequirementChange[] @relation("EnrollmentRequirementChanger")
  packagesRequirementsConfirmed TrainingPackage[]            @relation("PackageRequirementConfirmer")
  vehicleAuditLogs              VehicleAuditLog[]            @relation("VehicleAuditActor")

  @@index([role, status])
}

model StudentProfile {
  userId                      String               @id
  fullName                    String
  address                     String
  birthday                    DateTime             @db.Date
  nicNumber                   String               @unique
  phoneNumber                 String
  startDate                   DateTime?            @db.Date
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  user                        User                 @relation(fields: [userId], references: [userId], onDelete: Restrict)
  approvedRegistrationRequest RegistrationRequest?
  enrollments                 Enrollment[]
  lessons                     LessonSchedule[]
  medicalAppointments         StudentMedical[]
  exams                       StudentExam[]

  @@index([fullName])
  @@index([phoneNumber])
}

model InstructorProfile {
  userId          String                   @id
  fullName        String
  phoneNumber     String
  hireDate        DateTime                 @db.Date
  status          AccountStatus            @default(ACTIVE)
  /// Fixed monthly salary in LKR. Used as the default amount when a month is recorded. Null until the admin sets it.
  monthlySalary   Decimal?                 @db.Decimal(12, 2)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [userId], onDelete: Restrict)
  availability    InstructorAvailability[]
  lessonSchedules LessonSchedule[]
  lessonFeedback  LessonFeedback[]
  salaryMonths    InstructorSalaryMonth[]

  @@index([fullName])
  @@index([status])
}

enum SalaryMonthStatus {
  UNPAID
  PAID
}

/// One salary month for one instructor. The amount is copied when the month is recorded, so later changes to the
/// fixed salary do not rewrite past months.
model InstructorSalaryMonth {
  id               String            @id @default(cuid())
  instructorUserId String
  /// First day of the salary month, for example 2026-10-01.
  salaryMonth      DateTime          @db.Date
  amount           Decimal           @db.Decimal(12, 2)
  status           SalaryMonthStatus @default(UNPAID)
  paidOn           DateTime?         @db.Date
  note             String?           @db.VarChar(300)
  recordedByUserId String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  instructor       InstructorProfile @relation(fields: [instructorUserId], references: [userId], onDelete: Restrict)

  @@unique([instructorUserId, salaryMonth])
  @@index([salaryMonth])
}

model RegistrationRequest {
  id                       String             @id @default(cuid())
  referenceNumber          String             @unique
  status                   RegistrationStatus @default(PENDING)
  fullName                 String
  birthday                 DateTime           @db.Date
  nicNumber                String
  phoneNumber              String
  address                  String
  email                    String
  passwordHash             String
  additionalNote           String?
  selectedPackageId        String
  packagePriceAtSubmission Decimal            @db.Decimal(10, 2)
  submittedAt              DateTime           @default(now())
  reviewedAt               DateTime?
  reviewedByUserId         String?
  rejectionReason          String?
  approvedStudentUserId    String?            @unique
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  selectedPackage          TrainingPackage    @relation(fields: [selectedPackageId], references: [id], onDelete: Restrict)
  reviewedBy               User?              @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [userId], onDelete: SetNull)
  studentProfile           StudentProfile?    @relation(fields: [approvedStudentUserId], references: [userId], onDelete: Restrict)
  payments                 Payment[]
  enrollment               Enrollment?
  sessionSelections        RegistrationSessionSelection[]

  @@index([status, submittedAt])
  @@index([phoneNumber])
  @@index([nicNumber])
  @@index([email])
}

model TrainingPackage {
  id                            String                       @id @default(cuid())
  name                          String
  packageType                   PackageType
  description                   String?
  price                         Decimal                      @db.Decimal(10, 2)
  durationDays                  Int?
  sessionDurationMinutes        Int?
  isActive                      Boolean                      @default(true)
  sortOrder                     Int                          @default(0)
  requirementsConfirmedAt       DateTime?
  requirementsConfirmedByUserId String?
  requirementsConfirmedBy       User?                        @relation("PackageRequirementConfirmer", fields: [requirementsConfirmedByUserId], references: [userId], onDelete: SetNull)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  items                         TrainingPackageItem[]
  registrationRequests          RegistrationRequest[]
  enrollments                   Enrollment[]
  priceChanges                  TrainingPackagePriceChange[]
  requirementChanges            TrainingPackageItemChange[]

  @@index([packageType, isActive])
  @@index([name])
}

// One row per change to a package session requirement. The item ID is plain text, not a foreign key, so a removed
// requirement still appears in the history.
model TrainingPackageItemChange {
  id                       String          @id @default(cuid())
  packageId                String
  packageItemId            String?
  vehicleType              VehicleType
  trainingType             TrainingType
  previousRequiredSessions Int?
  newRequiredSessions      Int?
  changedByUserId          String?
  changedAt                DateTime        @default(now())
  package                  TrainingPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  changedBy                User?           @relation("PackageRequirementChanger", fields: [changedByUserId], references: [userId], onDelete: SetNull)

  @@index([packageId, changedAt])
}

// One row per price change made from the admin pricing page. Snapshot prices on applications, enrollments and
// payments are separate columns and are never changed by this table.
model TrainingPackagePriceChange {
  id              String          @id @default(cuid())
  packageId       String
  previousPrice   Decimal         @db.Decimal(10, 2)
  newPrice        Decimal         @db.Decimal(10, 2)
  changedByUserId String?
  changedAt       DateTime        @default(now())
  package         TrainingPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  changedBy       User?           @relation("PackagePriceChanger", fields: [changedByUserId], references: [userId], onDelete: SetNull)

  @@index([packageId, changedAt])
}

model TrainingPackageItem {
  id               String          @id @default(cuid())
  packageId        String
  vehicleType      VehicleType
  trainingType     TrainingType
  requiredSessions Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  package          TrainingPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, vehicleType, trainingType])
  @@index([vehicleType, trainingType])
}

model Vehicle {
  maintenanceInsurancePolicies     VehicleInsurancePolicy[]
  maintenanceComplianceDecisions   VehicleComplianceDecision[]
  maintenanceEmissionTests         VehicleEmissionTest[]
  maintenanceRevenueLicences       VehicleRevenueLicence[]
  maintenanceServiceRecords        VehicleServiceRecord[]
  maintenanceFaults                VehicleFault[]
  maintenanceDocuments             VehicleMaintenanceDocument[]
  maintenanceReminders             VehicleMaintenanceReminder[]
  maintenanceAuditLogs             VehicleMaintenanceAuditLog[]
  id                 String           @id @default(cuid())
  vehicleType        VehicleType
  registrationNumber String           @unique
  make               String?
  model              String?
  manufacturingYear  Int?
  colour             String?
  transmissionType   TransmissionType @default(NOT_APPLICABLE)
  status             VehicleStatus    @default(ACTIVE)
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  lessonSchedules    LessonSchedule[]
  auditLogs          VehicleAuditLog[]

  // Lets a lesson reference (vehicleId, vehicleType) so the database rejects a vehicle/type mismatch.
  @@unique([id, vehicleType])
  @@index([vehicleType, status])
}

// Append-only record of changes to a vehicle. Rows are never updated or deleted (enforced by a trigger).
model VehicleAuditLog {
  id             String             @id @default(cuid())
  vehicleId      String
  action         VehicleAuditAction
  previousStatus VehicleStatus?
  newStatus      VehicleStatus?
  // The vehicle's own non-sensitive fields as { field: { from, to } }, or the lesson IDs and resolutions for a status change.
  changes        Json?
  actorUserId    String
  createdAt      DateTime           @default(now())
  vehicle        Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  actor          User               @relation("VehicleAuditActor", fields: [actorUserId], references: [userId], onDelete: Restrict)

  @@index([vehicleId, createdAt])
  @@index([actorUserId, createdAt])
}

model Payment {
  id                    String                 @id @default(cuid())
  registrationRequestId String?
  enrollmentId          String?
  amount                Decimal                @db.Decimal(10, 2)
  paymentMethod         PaymentMethod
  paymentDate           DateTime
  status                PaymentStatus          @default(PENDING)
  transactionReference  String?
  bankName              String?
  accountHolderName     String?
  // Only the last four digits are stored. The full number is never persisted.
  accountNumberLast4    String?                @db.VarChar(4)
  branch                String?
  reviewedByUserId      String?
  lastReviewedAt        DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  registrationRequest   RegistrationRequest?   @relation(fields: [registrationRequestId], references: [id], onDelete: Restrict)
  enrollment            Enrollment?            @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  reviewedBy            User?                  @relation("PaymentReviewer", fields: [reviewedByUserId], references: [userId], onDelete: SetNull)
  slips                 PaymentSlip[]
  reviewHistory         PaymentReviewHistory[]

  @@index([status, paymentDate])
  @@index([registrationRequestId])
  @@index([enrollmentId])
  @@index([transactionReference])
}

model PaymentSlip {
  id               String   @id @default(cuid())
  paymentId        String
  storageKey       String
  originalFileName String
  mimeType         String
  fileSizeBytes    Int
  uploadedAt       DateTime @default(now())
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, uploadedAt])
}

model PaymentReviewHistory {
  id             String                @id @default(cuid())
  paymentId      String
  reviewerUserId String
  decision       PaymentReviewDecision
  reason         String?
  reviewedAt     DateTime              @default(now())
  payment        Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reviewer       User                  @relation("PaymentReviewUser", fields: [reviewerUserId], references: [userId], onDelete: Restrict)

  @@index([paymentId, reviewedAt])
}

model Enrollment {
  id                    String                          @id @default(cuid())
  studentUserId         String
  packageId             String
  registrationRequestId String?                         @unique
  enrollmentDate        DateTime                        @default(now())
  agreedPrice           Decimal                         @db.Decimal(10, 2)
  finalFee              Decimal                         @db.Decimal(10, 2)
  status                EnrollmentStatus                @default(ACTIVE)
  completedAt           DateTime?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  student               StudentProfile                  @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  package               TrainingPackage                 @relation(fields: [packageId], references: [id], onDelete: Restrict)
  registrationRequest   RegistrationRequest?            @relation(fields: [registrationRequestId], references: [id], onDelete: Restrict)
  payments              Payment[]
  trainingRequirements  EnrollmentTrainingRequirement[]

  // A student may hold several active enrollments, including in the same package.
  @@index([studentUserId, status])
  @@index([packageId])
}

// requiredSessions is NULL while the school has not yet confirmed the count ("allocation pending").
// Session counts chosen by the applicant for one registration (Regular fixed at 15, Trial 1 to 5 per vehicle).
// Copied into enrollment requirements at approval. Rows are never edited in place.
model RegistrationSessionSelection {
  id                    String              @id @default(cuid())
  registrationRequestId String
  vehicleType           VehicleType
  trainingType          TrainingType
  requiredSessions      Int
  createdAt             DateTime            @default(now())
  registrationRequest   RegistrationRequest @relation(fields: [registrationRequestId], references: [id], onDelete: Restrict)

  @@unique([registrationRequestId, vehicleType, trainingType], map: "RegistrationSessionSelection_unique")
}

model EnrollmentTrainingRequirement {
  id               String           @id @default(cuid())
  enrollmentId     String
  vehicleType      VehicleType
  trainingType     TrainingType
  requiredSessions Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  enrollment       Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessons          LessonSchedule[]

  @@unique([enrollmentId, vehicleType, trainingType])
}

// One row for each confirmation or change of a requirement's count. Append-only, enforced by a trigger in the migration.
model EnrollmentRequirementChange {
  id                       String   @id @default(cuid())
  requirementId            String
  enrollmentId             String
  previousRequiredSessions Int?
  newRequiredSessions      Int
  reason                   String
  changedByUserId          String
  changedAt                DateTime @default(now())
  changedBy                User     @relation("EnrollmentRequirementChanger", fields: [changedByUserId], references: [userId], onDelete: Restrict)

  @@index([requirementId, changedAt])
}

// One practical lesson: exactly one student, one instructor and one vehicle.
// Overlap, availability, status and time-order rules are enforced in the migration SQL (exclusion
// constraints, CHECK constraints and a booking trigger), because Prisma cannot express them.
model LessonSchedule {
  id                       String                        @id @default(cuid())
  lessonDate               DateTime                      @db.Date
  startTime                DateTime                      @db.Time(0)
  endTime                  DateTime                      @db.Time(0)
  durationMinutes          Int
  instructorUserId         String
  vehicleId                String
  vehicleType              VehicleType
  studentUserId            String
  enrollmentId             String
  trainingType             TrainingType
  status                   LessonScheduleStatus          @default(SCHEDULED)
  attendance               AttendanceStatus?
  attendanceMarkedAt       DateTime?
  attendanceMarkedByUserId String?
  notes                    String?
  cancellationReason       String?
  cancelledAt              DateTime?
  cancelledByUserId        String?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  instructor               InstructorProfile             @relation(fields: [instructorUserId], references: [userId], onDelete: Restrict)
  vehicle                  Vehicle                       @relation(fields: [vehicleId, vehicleType], references: [id, vehicleType], onDelete: Restrict)
  student                  StudentProfile                @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  requirement              EnrollmentTrainingRequirement @relation(fields: [enrollmentId, vehicleType, trainingType], references: [enrollmentId, vehicleType, trainingType], onDelete: Restrict)
  attendanceMarkedBy       User?                         @relation("AttendanceMarker", fields: [attendanceMarkedByUserId], references: [userId], onDelete: SetNull)
  cancelledBy              User?                         @relation("LessonCanceller", fields: [cancelledByUserId], references: [userId], onDelete: SetNull)
  feedback                 LessonFeedback?

  @@index([lessonDate, startTime, endTime])
  @@index([instructorUserId, lessonDate])
  @@index([vehicleId, lessonDate])
  @@index([studentUserId, lessonDate])
  @@index([enrollmentId, status])
}

// Date-specific availability window. A lesson must fit entirely inside one window of its instructor.
model InstructorAvailability {
  id               String            @id @default(cuid())
  instructorUserId String
  availabilityDate DateTime          @db.Date
  startTime        DateTime          @db.Time(0)
  endTime          DateTime          @db.Time(0)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  instructor       InstructorProfile @relation(fields: [instructorUserId], references: [userId], onDelete: Cascade)

  @@index([instructorUserId, availabilityDate])
}

// The fixed session times students and instructors use. A lesson takes one whole slot. Admins change the times and
// open or close a slot. Instructors take slots, and each slot can have any number of instructors at the same time.
model SessionSlot {
  id        String   @id @default(cuid())
  sortOrder Int      @unique
  startTime DateTime @unique @db.Time(0)
  endTime   DateTime @db.Time(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LessonFeedback {
  id               String            @id @default(cuid())
  lessonScheduleId String            @unique
  instructorUserId String
  feedback         String
  rating           Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lesson           LessonSchedule    @relation(fields: [lessonScheduleId], references: [id], onDelete: Cascade)
  instructor       InstructorProfile @relation(fields: [instructorUserId], references: [userId], onDelete: Restrict)

  @@index([instructorUserId, createdAt])
}

model StudentMedical {
  id              String                   @id @default(cuid())
  studentUserId   String
  appointmentDate DateTime
  status          MedicalAppointmentStatus @default(SCHEDULED)
  description     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  student         StudentProfile           @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  dateHistory     AppointmentDateHistory[] @relation("MedicalDateHistory")

  @@index([studentUserId, appointmentDate])
  @@index([status, appointmentDate])
}

model StudentExam {
  id            String                   @id @default(cuid())
  studentUserId String
  examType      ExamType
  vehicleType   VehicleType?
  scheduledDate DateTime
  status        ExamStatus               @default(SCHEDULED)
  result        ExamResult?
  description   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  student       StudentProfile           @relation(fields: [studentUserId], references: [userId], onDelete: Restrict)
  dateHistory   AppointmentDateHistory[] @relation("ExamDateHistory")

  @@index([studentUserId, scheduledDate])
  @@index([status, scheduledDate])
}

model AppointmentDateHistory {
  id                 String          @id @default(cuid())
  appointmentType    AppointmentType
  studentMedicalId   String?
  studentExamId      String?
  previousDate       DateTime
  newDate            DateTime
  reason             String?
  changedByUserId    String
  changedAt          DateTime        @default(now())
  medicalAppointment StudentMedical? @relation("MedicalDateHistory", fields: [studentMedicalId], references: [id], onDelete: Restrict)
  exam               StudentExam?    @relation("ExamDateHistory", fields: [studentExamId], references: [id], onDelete: Restrict)
  changedBy          User            @relation("AppointmentChangedBy", fields: [changedByUserId], references: [userId], onDelete: Restrict)

  @@index([studentMedicalId, changedAt])
  @@index([studentExamId, changedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([newEmail])
}

// ---------------------------------------------------------------------------
// Vehicle maintenance (see docs/vehicle-maintenance/DESIGN.md).
// SQL-only rules (CHECK constraints, triggers, functions and one partial index) are in
// docs/vehicle-maintenance/DRAFT-migration.sql and must be kept when the migration is written by hand.
// ---------------------------------------------------------------------------

enum ComplianceCategory {
  EMISSION_TEST
  REVENUE_LICENCE
}

enum ComplianceDecisionKind {
  NOT_APPLICABLE
  EXCEPTION_DOCUMENTED
}

enum EmissionTestResult {
  PASS
  FAIL
}

enum ServiceCategory {
  ROUTINE_SERVICE
  MECHANICAL_INSPECTION
  CORRECTIVE_SERVICE
}

enum ChecklistItem {
  ENGINE
  BRAKES
  SUSPENSION
  STEERING
  TYRES
  BATTERY
  LIGHTS
  LEAKS
  ELECTRICAL
}

enum ChecklistResult {
  PASS
  ATTENTION
  FAIL
  NOT_CHECKED
}

enum FaultSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RepairStatus {
  REPORTED
  DIAGNOSED
  IN_REPAIR
  COMPLETED
  CANCELLED
}

enum MaintenanceDocumentKind {
  INSURANCE_POLICY
  EMISSION_CERTIFICATE
  REVENUE_LICENCE
  SERVICE_INVOICE
  INSPECTION_REPORT
}

enum ReminderCategory {
  INSURANCE
  EMISSION_TEST
  REVENUE_LICENCE
  SERVICE
}

enum ReminderStatus {
  OPEN
  ACKNOWLEDGED
  SUPERSEDED
}

model VehicleInsurancePolicy {
  id               String                   @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  insurer          String
  policyNumber     String
  coverage         String
  coverageDetails  String?
  startsOn         DateTime                 @db.Date
  expiresOn        DateTime                 @db.Date
  premium          Decimal                  @db.Decimal(10, 2)
  notes            String?
  renewsPolicyId   String?
  renewsPolicy     VehicleInsurancePolicy?  @relation("PolicyRenewal", fields: [renewsPolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  renewedBy        VehicleInsurancePolicy[] @relation("PolicyRenewal")
  supersedesId     String?
  supersedes       VehicleInsurancePolicy?  @relation("PolicySupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy     VehicleInsurancePolicy[] @relation("PolicySupersession")
  recordedByUserId String
  recordedBy       User                     @relation(fields: [recordedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  recordedAt       DateTime                 @default(now()) @db.Timestamp(3)
  documents        VehicleMaintenanceDocument[]

  @@unique([vehicleId, policyNumber, startsOn])
  @@index([vehicleId, expiresOn])
  @@index([renewsPolicyId])
}

model VehicleComplianceDecision {
  id              String                 @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category        ComplianceCategory
  decision        ComplianceDecisionKind
  reason          String
  decidedByUserId String
  decidedBy       User                   @relation(fields: [decidedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  decidedAt       DateTime               @default(now()) @db.Timestamp(3)

  @@index([vehicleId, category, decidedAt])
}

model VehicleEmissionTest {
  id                   String               @id @default(cuid())
  vehicleId            String
  vehicle              Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  testedOn             DateTime             @db.Date
  result               EmissionTestResult?
  certificateNumber    String?
  issuedOn             DateTime?            @db.Date
  certificateExpiresOn DateTime?            @db.Date
  nextDueOn            DateTime?            @db.Date
  testingCentre        String?
  notes                String?
  supersedesId         String?
  supersedes           VehicleEmissionTest? @relation("EmissionTestSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy         VehicleEmissionTest[] @relation("EmissionTestSupersession")
  recordedByUserId     String
  recordedBy           User                 @relation(fields: [recordedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  recordedAt           DateTime             @default(now()) @db.Timestamp(3)
  documents            VehicleMaintenanceDocument[]

  @@index([vehicleId, testedOn])
  @@index([vehicleId, certificateExpiresOn])
  @@index([vehicleId, nextDueOn])
}

model VehicleRevenueLicence {
  id               String                 @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  licenceNumber    String?
  issuedOn         DateTime?              @db.Date
  renewedOn        DateTime?              @db.Date
  dueOn            DateTime               @db.Date
  notes            String?
  renewsLicenceId  String?
  renewsLicence    VehicleRevenueLicence? @relation("LicenceRenewal", fields: [renewsLicenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  renewedBy        VehicleRevenueLicence[] @relation("LicenceRenewal")
  supersedesId     String?
  supersedes       VehicleRevenueLicence? @relation("LicenceSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy     VehicleRevenueLicence[] @relation("LicenceSupersession")
  recordedByUserId String
  recordedBy       User                   @relation(fields: [recordedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  recordedAt       DateTime               @default(now()) @db.Timestamp(3)
  documents        VehicleMaintenanceDocument[]

  @@index([vehicleId, dueOn])
  @@index([renewsLicenceId])
}

model VehicleServiceRecord {
  id                    String                       @id @default(cuid())
  vehicleId             String
  vehicle               Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category              ServiceCategory
  serviceDate           DateTime                     @db.Date
  odometerKm            Int?
  providerName          String?
  workPerformed         String?
  findings              String?
  recommendations       String?
  partsCost             Decimal                      @default(0) @db.Decimal(10, 2)
  labourCost            Decimal                      @default(0) @db.Decimal(10, 2)
  totalCost             Decimal                      @db.Decimal(10, 2)
  nextServiceDate       DateTime?                    @db.Date
  nextServiceOdometerKm Int?
  notes                 String?
  supersedesId          String?
  supersedes            VehicleServiceRecord?        @relation("ServiceSupersession", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy          VehicleServiceRecord[]       @relation("ServiceSupersession")
  faultId               String?
  fault                 VehicleFault?                @relation("ServiceFaultLink", fields: [faultId, vehicleId], references: [id, vehicleId], onDelete: Restrict, onUpdate: Cascade)
  recordedByUserId      String
  recordedBy            User                         @relation(fields: [recordedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  recordedAt            DateTime                     @default(now()) @db.Timestamp(3)
  checklistItems        VehicleServiceChecklistItem[]
  documents             VehicleMaintenanceDocument[]

  @@index([vehicleId, serviceDate])
  @@index([vehicleId, nextServiceDate])
  @@index([faultId])
}

model VehicleServiceChecklistItem {
  id              String          @id @default(cuid())
  serviceRecordId String
  serviceRecord   VehicleServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  item            ChecklistItem
  result          ChecklistResult
  note            String?

  @@unique([serviceRecordId, item])
}

model VehicleFault {
  id               String          @id @default(cuid())
  vehicleId        String
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  severity         FaultSeverity
  description      String
  makesUnavailable Boolean
  status           RepairStatus    @default(REPORTED)
  reportedAt       DateTime        @db.Timestamp(3)
  reportedByUserId String
  reportedBy       User            @relation(fields: [reportedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  workshop         String?
  diagnosis        String?
  workPerformed    String?
  repairCost       Decimal?        @db.Decimal(10, 2)
  completedAt      DateTime?       @db.Timestamp(3)
  createdAt        DateTime        @default(now()) @db.Timestamp(3)
  updatedAt        DateTime        @updatedAt @db.Timestamp(3)
  repairEvents     VehicleRepairEvent[]
  linkedServices   VehicleServiceRecord[] @relation("ServiceFaultLink")
  documents        VehicleMaintenanceDocument[]

  // Lets a corrective service name (faultId, vehicleId) so the database refuses a link to another vehicle's fault.
  @@unique([id, vehicleId])
  @@index([vehicleId, status])
  @@index([status, severity])
}

model VehicleRepairEvent {
  id             String        @id @default(cuid())
  faultId        String
  fault          VehicleFault  @relation(fields: [faultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  eventType      String
  previousStatus RepairStatus?
  newStatus      RepairStatus?
  note           String?
  amount         Decimal?      @db.Decimal(10, 2)
  actorUserId    String
  actor          User          @relation(fields: [actorUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime      @default(now()) @db.Timestamp(3)

  @@index([faultId, createdAt])
}

model VehicleMaintenanceDocument {
  id                   String                  @id @default(cuid())
  vehicleId            String
  vehicle              Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  kind                 MaintenanceDocumentKind
  insurancePolicyId    String?
  insurancePolicy      VehicleInsurancePolicy? @relation(fields: [insurancePolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  emissionTestId       String?
  emissionTest         VehicleEmissionTest?    @relation(fields: [emissionTestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  revenueLicenceId     String?
  revenueLicence       VehicleRevenueLicence?  @relation(fields: [revenueLicenceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  serviceRecordId      String?
  serviceRecord        VehicleServiceRecord?   @relation(fields: [serviceRecordId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  faultId              String?
  fault                VehicleFault?           @relation(fields: [faultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacesDocumentId   String?
  replaces             VehicleMaintenanceDocument?  @relation("DocumentReplacement", fields: [replacesDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacedBy           VehicleMaintenanceDocument[] @relation("DocumentReplacement")
  storageKey           String                  @unique
  originalFileName     String
  mimeType             String
  fileSizeBytes        Int
  sha256               String                  @db.Char(64)
  uploadedByUserId     String
  uploadedBy           User                    @relation("DocumentUploader", fields: [uploadedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  uploadedAt           DateTime                @default(now()) @db.Timestamp(3)
  deletedAt            DateTime?               @db.Timestamp(3)
  deletedByUserId      String?
  deletedBy            User?                   @relation("DocumentDeleter", fields: [deletedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  deletionReason       String?

  @@index([vehicleId, kind])
}

model VehicleMaintenanceReminder {
  id                     String           @id @default(cuid())
  vehicleId              String
  vehicle                Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category               ReminderCategory
  // Polymorphic: names the insurance, test, licence or service record that is due. No database foreign key, by design.
  targetRecordId         String
  dueOn                  DateTime         @db.Date
  leadDays               Int
  status                 ReminderStatus   @default(OPEN)
  createdAt              DateTime         @default(now()) @db.Timestamp(3)
  acknowledgedAt         DateTime?        @db.Timestamp(3)
  acknowledgedByUserId   String?
  acknowledgedBy         User?            @relation(fields: [acknowledgedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([vehicleId, category, targetRecordId, dueOn, leadDays])
  @@index([status, dueOn])
}

model VehicleMaintenanceReminderSetting {
  category        ReminderCategory
  leadDays        Int
  updatedByUserId String
  updatedBy       User           @relation(fields: [updatedByUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  updatedAt       DateTime       @default(now()) @db.Timestamp(3)

  @@id([category, leadDays])
}

model VehicleMaintenanceAuditLog {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entityType   String
  entityId     String
  action       String
  reason       String?
  summary      Json?
  actorUserId  String
  actor        User     @relation(fields: [actorUserId], references: [userId], onDelete: Restrict, onUpdate: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamp(3)

  @@index([vehicleId, createdAt])
  @@index([actorUserId, createdAt])
}
