# Application database (pooled connection, used by the running app).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:15433/riona_db"

# Direct (non-pooled) connection, used by Prisma migrations. Set it to the same value as DATABASE_URL for a local database.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:15433/riona_db"

# Tests only: a disposable LOCAL database whose name ends with _test (never Neon or the development database).
# TEST_DATABASE_URL="postgresql://riona_user:PASSWORD@localhost:15432/riona_test"

# The public origin of the site, for example "https://www.example.com".
# Required in production: it is the origin used in emailed links and the CSRF origin check.
# APP_ORIGIN="http://localhost:3000"

# Email delivery for password resets, email changes and instructor invitations (server-only, never prefix with NEXT_PUBLIC_).
# Without these, reset and invitation emails are not sent and the related requests fail safely.
# RESEND_API_KEY="re_..."
# AUTH_EMAIL_FROM="Riyona Driving School <no-reply@your-verified-domain.lk>"

# WhatsApp Cloud API for the contact form (server-only, never prefix with NEXT_PUBLIC_).
# Without these, the contact form shows a WhatsApp link instead of sending the message.
# WHATSAPP_CLOUD_TOKEN="EAA..."
# WHATSAPP_PHONE_NUMBER_ID="..."          # Meta ID of the school's sending number (0717066759)
# WHATSAPP_STAFF_RECIPIENT="94..."        # staff number that receives enquiries; must differ from the sender
# WHATSAPP_CONTACT_TEMPLATE="..."         # approved template: {{1}} name, {{2}} phone, {{3}} vehicle, {{4}} message
# WHATSAPP_TEMPLATE_LANGUAGE="en"
# WHATSAPP_GRAPH_VERSION="v21.0"
